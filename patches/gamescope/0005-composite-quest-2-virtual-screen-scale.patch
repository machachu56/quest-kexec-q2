diff -ruN a/src/rendervulkan.cpp b/src/rendervulkan.cpp
--- a/src/rendervulkan.cpp	2026-10-07 00:11:11.759012901 +0200
+++ b/src/rendervulkan.cpp	2026-10-07 00:11:11.793892242 +0200
@@ -1161,7 +1161,16 @@
 	static const uint32_t s_uQkxStereo =
 		( env_to_bool( getenv( "GAMESCOPE_QKX_STEREO" ) ) ? CompositeDebugFlag::QkxStereo : 0u ) |
 		( env_to_bool( getenv( "GAMESCOPE_QKX_FLIPX" ) ) ? CompositeDebugFlag::QkxFlipX : 0u ) |
-		( env_to_bool( getenv( "GAMESCOPE_QKX_FLIPY" ) ) ? CompositeDebugFlag::QkxFlipY : 0u );
+		( env_to_bool( getenv( "GAMESCOPE_QKX_FLIPY" ) ) ? CompositeDebugFlag::QkxFlipY : 0u ) |
+		[]() -> uint32_t {
+			// GAMESCOPE_QKX_SCALE=<percent>: nearest of 100, 85, 70, 55.
+			const char *pszScale = getenv( "GAMESCOPE_QKX_SCALE" );
+			int nPercent = pszScale ? atoi( pszScale ) : 100;
+			if ( nPercent >= 93 ) return 0u;
+			if ( nPercent >= 78 ) return CompositeDebugFlag::QkxScale1;
+			if ( nPercent >= 63 ) return CompositeDebugFlag::QkxScale2;
+			return CompositeDebugFlag::QkxScale1 | CompositeDebugFlag::QkxScale2;
+		}();
 	effective_debug |= s_uQkxStereo;
 	if ( g_bSteamIsActiveWindow )
 		effective_debug &= ~(CompositeDebugFlag::Heatmap | CompositeDebugFlag::Heatmap_MSWCG | CompositeDebugFlag::Heatmap_Hard);
