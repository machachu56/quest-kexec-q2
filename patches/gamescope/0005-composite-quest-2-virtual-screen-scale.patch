             l.x = L.x - 1.0f - l.x;
         if (checkDebugFlag(compositedebug_QkxFlipY))
             l.y = L.y - 1.0f - l.y;
+        // Virtual screen size (GAMESCOPE_QKX_SCALE): shrink the image around
