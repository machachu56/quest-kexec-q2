+// Qualcomm SDE with a dual layer-mixer topology (two DSC encoders, two DSI
+// links, e.g. Quest 2) scans out garbage from a single plane spanning both
+// mixers, but works with one plane per mixer. With GAMESCOPE_DRM_SPLIT_PLANES=1
+// every layer is presented as a left and a right half on separate planes.
+static bool qkx_split_planes()
+{
+	static const bool s_bSplit = env_to_bool( getenv( "GAMESCOPE_DRM_SPLIT_PLANES" ) );
+	return s_bSplit;
+}
+
+static void qkx_lset( struct drm_t *drm, int i, const char *pszName, uint64_t ulValue )
+{
+	liftoff_layer_set_property( drm->lo_layers[ i ], pszName, ulValue );
+	if ( drm->lo_layers_split[ i ] )
+		liftoff_layer_set_property( drm->lo_layers_split[ i ], pszName, ulValue );
+}
+
+static void qkx_lunset( struct drm_t *drm, int i, const char *pszName )
+{
+	liftoff_layer_unset_property( drm->lo_layers[ i ], pszName );
+	if ( drm->lo_layers_split[ i ] )
+		liftoff_layer_unset_property( drm->lo_layers_split[ i ], pszName );
+}
