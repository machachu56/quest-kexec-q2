diff --git a/src/shaders/cs_composite_blit.comp b/src/shaders/cs_composite_blit.comp
index d2ef47b..0c56670 100644
--- a/src/shaders/cs_composite_blit.comp
+++ b/src/shaders/cs_composite_blit.comp
@@ -29,6 +29,23 @@ void main() {
     vec2 uv = vec2(coord);
     vec4 outputValue = vec4(0.0f);
 
+    if (checkDebugFlag(compositedebug_QkxStereo)) {
+        // Quest 2: one portrait panel, the two eyes stacked along y, each eye
+        // seeing its half rotated by 90 degrees. Map this panel pixel to a
+        // logical per-eye screen (eyeH x panel width), then into the normal
+        // layout space with a uniform, centred scale so aspect is preserved.
+        vec2 P = vec2(outSize);
+        float eyeH = P.y * 0.5f;
+        vec2 L = vec2(eyeH, P.x);
+        vec2 l = vec2(mod(float(coord.y), eyeH), float(coord.x));
+        if (checkDebugFlag(compositedebug_QkxFlipX))
+            l.x = L.x - 1.0f - l.x;
+        if (checkDebugFlag(compositedebug_QkxFlipY))
+            l.y = L.y - 1.0f - l.y;
+        float s = min(P.x / L.x, P.y / L.y);
+        uv = l * s + (P - L * s) * 0.5f;
+    }
+
     if (checkDebugFlag(compositedebug_PlaneBorders))
         outputValue = vec4(1.0f, 0.0f, 0.0f, 0.0f);
 
