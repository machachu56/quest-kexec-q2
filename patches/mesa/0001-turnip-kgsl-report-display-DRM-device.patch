+   /* KGSL is not a DRM driver, but on Qualcomm downstream kernels the
+    * display (msm_drm/SDE) shares dma-bufs with it. Report that DRM device
+    * through VK_EXT_physical_device_drm so compositors such as gamescope can
+    * pair this GPU with the KMS device. Overridable for multi-card systems.
+    */
+   {
+      const char *primary = getenv("TU_KGSL_DRM_PRIMARY");
+      const char *render = getenv("TU_KGSL_DRM_RENDER");
+      struct stat st;
+
+      if (!primary)
+         primary = "/dev/dri/card0";
+      if (!render)
+         render = "/dev/dri/renderD128";
+      if (stat(primary, &st) == 0 && S_ISCHR(st.st_mode)) {
+         device->has_master = true;
+         device->master_major = major(st.st_rdev);
+         device->master_minor = minor(st.st_rdev);
+      }
+      if (stat(render, &st) == 0 && S_ISCHR(st.st_mode)) {
+         device->has_local = true;
+         device->local_major = major(st.st_rdev);
+         device->local_minor = minor(st.st_rdev);
+      }
+   }
