From e651f02cd33e2e5bcadfde45c2345c1752860cc2 Mon Sep 17 00:00:00 2001
From: Pol <polvilagarcia@proton.me>
Date: Tue, 6 Oct 2026 17:38:38 +0200
Subject: [PATCH 6/7] qkx: wake the GPU RSC left asleep by the previous kernel

The loader suspends the GPU before kexec, so the previous kernel's GMU
slumber leaves the GPU RSC in its sleep state. This kernel's first cold
boot loaded the RSC microcode but skipped the wake sequence (no sleep
sequence recorded), and every GMU RPMh vote then stalled: HFI ack and
OOB_set timeouts. Run the wake once after the initial microcode load.
---
 drivers/gpu/msm/adreno_a6xx_gmu.c | 22 ++++++++++++++++++++--
 1 file changed, 20 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/msm/adreno_a6xx_gmu.c b/drivers/gpu/msm/adreno_a6xx_gmu.c
index 758cd13f4..be19a8aa0 100644
--- a/drivers/gpu/msm/adreno_a6xx_gmu.c
+++ b/drivers/gpu/msm/adreno_a6xx_gmu.c
@@ -1056,9 +1056,27 @@ static int a6xx_gmu_fw_start(struct kgsl_device *device,
 		gmu_core_regwrite(device, A6XX_GMU_GENERAL_7, 1);
 
 		if (!test_and_set_bit(GMU_BOOT_INIT_DONE,
-			&device->gmu_core.flags))
+			&device->gmu_core.flags)) {
 			ret = _load_gmu_rpmh_ucode(device);
-		else
+			/*
+			 * qkx: after kexec the GPU RSC is still in the sleep
+			 * state the previous kernel's GMU slumber left it in,
+			 * but this kernel's first boot never ran a sleep
+			 * sequence, so the wake below was skipped and every
+			 * GMU RPMh vote stalled (OOB/HFI ack timeouts). Wake it
+			 * unconditionally once; a fresh RSC acks immediately.
+			 */
+			if (!ret) {
+				set_bit(GMU_RSCC_SLEEP_SEQ_DONE,
+					&device->gmu_core.flags);
+				if (a6xx_rpmh_power_on_gpu(device))
+					dev_warn(&gmu->pdev->dev,
+						 "qkx: initial RSC wake failed\n");
+				else
+					dev_info(&gmu->pdev->dev,
+						 "qkx: GPU RSC woken from inherited sleep\n");
+			}
+		} else
 			ret = a6xx_rpmh_power_on_gpu(device);
 		if (ret)
 			return ret;
-- 
