#!/sbin/openrc-run
# Set the clock from the network. After the kexec nothing carries the time over
# from Android (the PMIC RTC is not kept in wall-clock time), so the system
# starts in 1970 and every TLS certificate (Steam login, store) looks invalid.
#
# Runs in the background: the USB link (udhcpd hands the PC its address) must
# come up first, and boot must not wait for an NTP server.
description="Set the clock by NTP"
command=/bin/sh
command_args="-c 'until ntpd -n -q -p time.cloudflare.com || ntpd -n -q -p pool.ntp.org; do sleep 5; done; exec ntpd -n -p pool.ntp.org'"
command_background=true
pidfile=/run/qkx-time.pid

depend() {
	need net
	after udhcpd
}
